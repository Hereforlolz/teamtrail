# Copy this file to .env and fill in real values.
# The bot checks these at startup and refuses to start if any are missing.

SLACK_BOT_TOKEN=xoxb-...
SLACK_USER_TOKEN=xoxp-...
SLACK_SIGNING_SECRET=...
SLACK_APP_TOKEN=xapp-...
GROQ_API_KEY=...

# Optional. Set this in the terminal/environment running the Notion MCP
# server itself (npx @notionhq/notion-mcp-server), not here — the server
# reads it directly, notion.js never sees it. Listed here only as a
# reminder it exists; the bot runs fine without it (Slack-only).
# NOTION_TOKEN=ntn_...

# Optional overrides — sane defaults are used if unset.
# NOTION_MCP_URL=http://127.0.0.1:3331/mcp
# NOTION_TIMEOUT_MS=8000
# CONTEXT_STORE_PATH=./data/context-store.json
# CONTEXT_STORE_MAX_AGE_DAYS=90
# RATE_LIMIT_MAX=10
# RATE_LIMIT_WINDOW_MS=300000

# Optional. Who can run /teamtrail-status — comma-separated Slack user
# IDs. Unset means nobody can (safe default, not "everyone can").
# ADMIN_USER_IDS=U01ABCDEF,U02GHIJKL
